# 1. 必填：从末尾选择供应商，将三个字段填到这里。
# 仅支持 OpenAI-compatible Chat Completions；模型必须支持所需工具调用。
# JSON 结果由提示词约束和程序校验实现，不要求原生 json_schema 响应模式。
# BASE_URL 是接口根地址，不要追加 /chat/completions。
# 替换占位符；真实 .env 不得提交 GitHub。
MODEL=replace-with-your-chat-model
BASE_URL=https://replace-with-your-provider/v1
API_KEY=replace-with-your-api-key

# 独立的 Tavily 搜索密钥，岗位联网调研需要。
TAVILY_API_KEY=replace-with-your-tavily-key
TAVILY_MAX_RESULTS=5

# 2. 预算：按所选模型实际上下文限制调整。
# 预检是通用估算＋安全余量，不是供应商分词器或费用硬上限。
CONTEXT_BUDGET=16000
MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
MAX_TOOL_ROUNDS=2
MAX_FOLLOW_UPS=3
MAX_TOTAL_FOLLOW_UPS=12

# 0关闭整场限制，但仍保留单次预检与台账。
# 收尾预留包含在整场额度内，首次调用时保存，重启不会重置。
# 初始配置需按实际工作量校准，不保证所有模型/材料均够用。
SESSION_TOKEN_BUDGET=500000
FINAL_REPORT_TOKEN_RESERVE=50000

# 3. 数据与隐私。删除会话同步删除调用台账及额度记录。
DATA_DIR=data
SESSION_DB=data/sessions.db
CHECKPOINT_DB=data/checkpoints.db
SESSION_STALE_DAYS=0
ENABLE_EXTERNAL_TRACING=false

# 4. 可选：面试题量与等级阈值。
TARGET_QUESTIONS=15
MIN_QUESTIONS=12
MAX_QUESTIONS=18
GRADE_THRESHOLDS=8,6,4
DIFFICULTY_WEIGHTING=true

# 5. 可选：摘要；摘要本身的模型消耗也计入额度。
COMPRESS_THRESHOLD=12000
KEEP_RECENT_MESSAGES=12

# 6. 可选：按模型官方文档选择输出参数及温度支持。
# max_tokens 或 max_completion_tokens，不自动猜测/重发切换参数。
LLM_OUTPUT_LIMIT_PARAM=max_tokens
LLM_SEND_TEMPERATURE=true
TEMP_PARSE=0.2
TEMP_PLAN=0.5
TEMP_ASK=0.7
TEMP_ASSESS=0.2
TEMP_FACT_CHECK=0.1
TEMP_EVALUATE=0.3
TEMP_FOLLOW_UP=0.4

# 7. 可选：OCR，需要本机 Tesseract 和 chi_sim、eng 语言数据。
# 设置语言名不等于已经安装，OCR自检会报告缺失依赖。
TESSERACT_CMD=tesseract
OCR_LANGUAGES=chi_sim+eng
OCR_TESSDATA_DIR=
OCR_TIMEOUT_SECONDS=30
OCR_PDF_DPI=300
OCR_PSM=6
OCR_ADAPTIVE_LANGUAGES=true
OCR_PDF_RENDERER=pdfium
POPPLER_PATH=

# 8. 可选：仅后台金额估算，默认关闭，未知不是零。
# 必须填写全部元数据，COST_MODEL匹配接口返回的实际模型ID。
# 单价单位每百万Token；币种不换算；每次调用冻结价格快照。
# 两单价模型不证明缓存/分档/优惠/税费等真实账单，前端不显示。
# COST_MODEL=接口返回的实际模型ID
# COST_CURRENCY=USD或CNY等三位币种代码
# COST_INPUT_PER_1M=供应商输入单价
# COST_OUTPUT_PER_1M=供应商输出单价
# COST_PRICE_SOURCE=https://供应商官方价格页面
# COST_PRICE_EFFECTIVE_DATE=YYYY-MM-DD

# 9. 供应商参考：任选一组复制到顶部，不要同时取消所有块的注释。
# 接口格式来自官方文档，除历史DeepSeek外，不代表本项目联网验收。

# DeepSeek：https://api-docs.deepseek.com/
# MODEL=控制台确认可用的聊天模型ID
# BASE_URL=https://api.deepseek.com
# API_KEY=你的DeepSeek密钥
# 历史请求deepseek-chat、返回deepseek-flash；别名以账户为准。

# OpenAI：https://developers.openai.com/api/reference/resources/chat/subresources/completions/methods/create
# MODEL=支持ChatCompletions及工具调用的模型ID
# BASE_URL=https://api.openai.com/v1
# API_KEY=你的OpenAI密钥
# 按模型文档选择 LLM_OUTPUT_LIMIT_PARAM=max_completion_tokens。
# 不支持温度的模型设置 LLM_SEND_TEMPERATURE=false。

# 阿里云百炼北京Workspace：https://help.aliyun.com/zh/model-studio/compatibility-of-openai-with-dashscope
# MODEL=控制台确认可用的模型ID
# BASE_URL=https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# API_KEY=对应地域的百炼密钥
# 其他地域使用控制台提供的兼容地址及同地域密钥。

# SiliconFlow：https://docs.siliconflow.cn/docs/userguide/quickstart
# MODEL=控制台显示的完整模型ID
# BASE_URL=https://api.siliconflow.cn/v1
# API_KEY=你的SiliconFlow密钥

# Ollama：https://docs.ollama.com/api/openai-compatibility
# MODEL=本机已安装且支持工具调用的模型名
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# ollama是SDK占位值；本地计算成本不能视为零。
# 原生Anthropic、Azure等接口形式需要专门适配，不宣称已经支持。
